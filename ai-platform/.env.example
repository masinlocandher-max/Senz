# Separate app service. Never commit actual values.
PORT=4181
PUBLIC_APP_URL=https://your-senz-app-host.example
SUPABASE_URL=https://your-dedicated-senz-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_SERVICE_ROLE_KEY=keep-server-only
PAYMONGO_SECRET_KEY=sk_test_replace
PAYMONGO_WEBHOOK_SECRET=replace-with-webhook-specific-secret
PAYMONGO_MODE=test
OPENAI_API_KEY=keep-server-only
OPENAI_MODEL=gpt-5-mini
# Map plan IDs to owner-approved PHP prices, e.g. {"workspace":<integer>} WITHOUT angle brackets.
SENZ_PLAN_PRICING_JSON={}
# Maximum AI calls per member per calendar month
SENZ_MONTHLY_AI_LIMIT=80
